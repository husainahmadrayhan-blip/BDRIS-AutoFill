# Copy to .env.local for local development. Replace placeholders locally.
# Render: use the Neon pooled connection string for DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional direct connection for manual migrations/maintenance only; the app does not use it.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
NEON_BRANCH=your-existing-branch-name

# Keep this stable across restarts. Generate a long random value.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Initial admin login. These are used when the database is first initialized.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Keep false for username/password authentication. Only set true for trusted local demo mode.
LOCAL_DIRECT_MODE=false
PORT=3000
PG_POOL_MAX=5

# Optional private link to a separately deployed automation service.
# Never expose the key to browsers or commit a real value.
AUTOMATION_SERVER_URL=
AUTOMATION_API_KEY=
