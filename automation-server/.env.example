# Separate from the main web server's .env/.env.local.
AUTOMATION_PORT=3001
AUTOMATION_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
AUTOMATION_ALLOWED_HOSTS=example.com
AUTOMATION_CONCURRENCY=1
AUTOMATION_JOB_TIMEOUT_MS=60000
AUTOMATION_NAVIGATION_TIMEOUT_MS=30000
AUTOMATION_SELECTOR_TIMEOUT_MS=10000
AUTOMATION_RETRY_LIMIT=0
# Optional system Chrome/Chromium path; otherwise Puppeteer's managed Chromium is used.
PUPPETEER_EXECUTABLE_PATH=
# Optional writable persistent directory; metadata only, job payloads are never persisted.
AUTOMATION_JOB_STORE=../.private/automation-jobs.json
